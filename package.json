{
  "name": "@mittwald/etracker-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "MCP server exposing the etracker Analytics Report API via Streamable HTTP",
  "author": "Tobias Wiesing <t.wiesing@mittwald.de> (https://github.com/twiesing)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mittwald/etracker-mcp.git"
  },
  "homepage": "https://github.com/mittwald/etracker-mcp",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
